    <!-- Toast Notification -->
    <div id="customToast" style="visibility: hidden; min-width: 250px; background-color: #333; color: #fff; text-align: center; border-radius: 8px; padding: 16px 24px; position: fixed; z-index: 10001; left: 50%; bottom: 30px; transform: translateX(-50%); box-shadow: 0 10px 25px rgba(0,0,0,0.3); font-size: 1rem; opacity: 0; transition: opacity 0.4s ease, bottom 0.4s ease; font-weight: 500;">
