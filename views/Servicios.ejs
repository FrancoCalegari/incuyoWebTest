    <!-- JavaScript -->
    <script src="/js/script.js"></script>
    <script>
        function showToast(message, isError = false) {
            const toast = document.getElementById("customToast");
            const toastMessage = document.getElementById("customToastMessage");
            if (!toast || !toastMessage) return;

            toastMessage.textContent = message;
            toast.style.backgroundColor = isError ? "#ef4444" : "#10b981";
            toast.style.visibility = "visible";
            toast.style.opacity = "1";
            toast.style.bottom = "50px";

            setTimeout(() => {
                toast.style.opacity = "0";
                toast.style.bottom = "30px";
                setTimeout(() => { toast.style.visibility = "hidden"; }, 400);
            }, 4000);
        }

        async function submitCompanyContact(event) {
            event.preventDefault();

            const btn = document.getElementById('companySubmitBtn');
            const feedback = document.getElementById('companyFormFeedback');
            const originalBtnContent = btn.innerHTML;

            const company_name = document.getElementById('companyName').value.trim();
            const contact_name = document.getElementById('contactName').value.trim();
            const email = document.getElementById('contactEmail').value.trim();
            const phone = document.getElementById('contactPhone').value.trim();
            const service_type = document.getElementById('serviceType').value;
            const message = document.getElementById('companyMessage').value.trim();

            if (!company_name || !contact_name || !email || !message) {
                showToast('Por favor complete todos los campos obligatorios (*)', true);
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right: 6px;"></i> Enviando solicitud...';
            feedback.style.display = 'none';

            try {
                const response = await fetch('/api/company-contact', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ company_name, contact_name, email, phone, service_type, message })
                });

                const data = await response.json();

                if (data.ok) {
                    document.getElementById('companyContactForm').reset();
                    feedback.style.display = 'block';
                    feedback.style.background = 'rgba(16, 185, 129, 0.15)';
                    feedback.style.border = '1px solid #10b981';
                    feedback.style.color = '#34d399';
                    feedback.innerHTML = '<i class="fas fa-check-circle" style="margin-right: 8px;"></i><strong>¡Solicitud enviada con éxito!</strong> Un coordinador de IncStudents se comunicará con su empresa a la brevedad.';
                    showToast('¡Solicitud enviada con éxito! Nos comunicaremos pronto.');
                } else {
                    feedback.style.display = 'block';
                    feedback.style.background = 'rgba(239, 68, 68, 0.15)';
                    feedback.style.border = '1px solid #ef4444';
                    feedback.style.color = '#f87171';
                    feedback.innerHTML = '<i class="fas fa-exclamation-triangle" style="margin-right: 8px;"></i>' + (data.error || 'Ocurrió un error al enviar la solicitud.');
                    showToast(data.error || 'Error al enviar la solicitud', true);
                }
            } catch (err) {
                console.error('Error al enviar formulario:', err);
                feedback.style.display = 'block';
                feedback.style.background = 'rgba(239, 68, 68, 0.15)';
                feedback.style.border = '1px solid #ef4444';
                feedback.style.color = '#f87171';
                feedback.innerHTML = '<i class="fas fa-wifi" style="margin-right: 8px;"></i> Error de conexión. Verifique su conexión o intente por WhatsApp.';
                showToast('Error de conexión al enviar el formulario', true);
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalBtnContent;
            }
        }
    </script>
</body>

</html>